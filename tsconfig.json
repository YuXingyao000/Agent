{
  // 只做类型检查（npm run check），不产出 .js：代码由 Node 直接运行 .ts（Node 运行时只擦掉类型注解）
  "compilerOptions": {
    "target": "esnext",
    "lib": ["esnext"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    // 以下三项是为了配合 Node 直接运行 .ts：
    "allowImportingTsExtensions": true, // 导入本地文件时写 "./foo.ts"
    "verbatimModuleSyntax": true,       // 只导入类型时必须写 import type
    "erasableSyntaxOnly": true,         // 禁用 enum、namespace 等不能直接擦除的语法
    "skipLibCheck": true
  },
  "include": ["practice", "my-agent"]
}
