{
  // ---------- TypeScript ----------
  // 编辑器用项目里装的 TypeScript（package.json 固定的版本），不用编辑器自带的版本，保证和 npm run check 结果一致。
  "typescript.tsdk": "node_modules/typescript/lib",
  "typescript.enablePromptUseWorkspaceTsdk": true,

  // ---------- Python（只用于临时实验）----------
  // 用 uv 装在项目里的 Python。这是 Windows 的路径；Mac 上执行一次 "Python: Select Interpreter"，
  // 选 .tools/bin/python3.12 即可。
  "python.defaultInterpreterPath": "${workspaceFolder}/.tools/bin/python3.12.exe",

  // ---------- 终端 ----------
  // 新开的终端自动激活项目环境（Node、npm、uv 都能直接用），省得每次手动执行 env.ps1 / source env.sh。
  // 终端默认在工作区根目录启动，所以这里用相对路径。
  "terminal.integrated.profiles.windows": {
    "Agent PowerShell": {
      "path": "powershell.exe",
      "args": ["-NoExit", "-ExecutionPolicy", "Bypass", "-Command", ". .\\env.ps1"]
    }
  },
  "terminal.integrated.defaultProfile.windows": "Agent PowerShell",
  "terminal.integrated.profiles.osx": {
    "Agent zsh": {
      "path": "zsh",
      "args": ["-c", "source ./env.sh && exec zsh -l"]
    }
  },
  "terminal.integrated.defaultProfile.osx": "Agent zsh"
}
